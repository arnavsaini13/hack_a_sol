# =====================================================================
# Database Configuration (Supabase PostgreSQL / SQLite)
# =====================================================================
# Option 1: Supabase PostgreSQL (Cloud Database for Production)
# In Supabase: Project Settings -> Database -> Connection string -> URI
# Copy the URI (format: postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres)
# DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Option 2: Local SQLite (Used automatically if DATABASE_URL is left empty or commented out)
# DATABASE_URL=sqlite:///agri_transparency.db

# Optional Connection Pool settings for Supabase/Postgres
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# =====================================================================
# Gemini AI Configuration (Official google-genai SDK)
# =====================================================================
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.1-flash-lite

# =====================================================================
# Deployment & CORS Configuration (Render / Railway / Vercel / Capacitor)
# =====================================================================
# Comma-separated list of allowed frontend origins (or "*" for wildcard)
CORS_ORIGINS=http://localhost:5173,https://localhost,capacitor://localhost,http://localhost
